{
  "rules": {
    ".read": false,
    ".write": false,
    "chats": {
      "$eventId": {
        ".read": "auth != null && !root.child(\"accountDeletionBlocks\").child(auth.uid).exists()",
        ".indexOn": [
          "messageTime",
          "senderUid"
        ],
        "$messageId": {
          ".write": "auth != null && !root.child(\"accountDeletionBlocks\").child(auth.uid).exists() && !data.exists() && newData.exists() && newData.child(\"senderUid\").val() === auth.uid",
          ".validate": "newData.hasChildren([\"messageText\", \"messageUser\", \"messageTime\", \"senderUid\"])",
          "messageText": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10000"
          },
          "messageUser": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "messageTime": {
            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 300000"
          },
          "senderUid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
